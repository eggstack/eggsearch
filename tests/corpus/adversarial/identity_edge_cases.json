{
  "name": "identity_edge_cases",
  "description": "Edge cases for identity/canonicalization of URLs",
  "cases": [
    {
      "category": "scheme",
      "input": "file:///etc/passwd",
      "description": "Unusual scheme: file://"
    },
    {
      "category": "scheme",
      "input": "ftp://example.com",
      "description": "Unusual scheme: ftp://"
    },
    {
      "category": "scheme",
      "input": "custom://resource",
      "description": "Custom/unknown scheme"
    },
    {
      "category": "empty",
      "input": "",
      "description": "Empty URL string"
    },
    {
      "category": "empty",
      "input": "http://",
      "description": "Scheme-only URL with no host"
    },
    {
      "category": "fragment",
      "input": "#section",
      "description": "URL with only a fragment"
    },
    {
      "category": "fragment",
      "input": "http://example.com#",
      "description": "URL with empty fragment"
    },
    {
      "category": "special_chars",
      "input": "http://example.com/path?query=value&other=123#frag",
      "description": "URL with query params and fragment"
    },
    {
      "category": "special_chars",
      "input": "http://example.com/path/with%20encoded%20spaces",
      "description": "URL with percent-encoded spaces"
    },
    {
      "category": "long_url",
      "input": "http://example.",
      "description": "Very long URL path (5000 chars)"
    },
    {
      "category": "multi_slash",
      "input": "http://////example.com//////path",
      "description": "URL with multiple consecutive slashes"
    },
    {
      "category": "encoded",
      "input": "http://example.com/%E4%BE%8B%E3%81%88/path",
      "description": "URL with encoded Unicode path"
    },
    {
      "category": "backslash",
      "input": "http:\\example.com\\path",
      "description": "URL with backslashes instead of forward slashes"
    },
    {
      "category": "unicode_domain",
      "input": "http://\u4f8b\u3048.jp/path",
      "description": "Unicode domain name (Japanese)"
    },
    {
      "category": "no_host",
      "input": "http:///path",
      "description": "URL with scheme and path but no host"
    },
    {
      "category": "mixed_slash",
      "input": "http://example.com\\path/to\\file",
      "description": "Mixed forward and backslashes"
    }
  ]
}