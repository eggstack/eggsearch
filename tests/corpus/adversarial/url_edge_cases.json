{
  "name": "url_edge_cases",
  "description": "Malformed and adversarial URL strings for testing validate_url",
  "cases": [
    {
      "input": "",
      "expected": "reject",
      "description": "Empty string"
    },
    {
      "input": "file:///etc/passwd",
      "expected": "reject",
      "description": "file:// scheme (local file access)"
    },
    {
      "input": "ftp://example.com/file.txt",
      "expected": "reject",
      "description": "ftp:// scheme"
    },
    {
      "input": "javascript:alert(1)",
      "expected": "reject",
      "description": "javascript: scheme (XSS vector)"
    },
    {
      "input": "data:text/html,<script>alert(1)</script>",
      "expected": "reject",
      "description": "data: scheme with HTML"
    },
    {
      "input": "http://example.",
      "expected": "reject",
      "description": "Very long URL path (10000+ chars)"
    },
    {
      "input": "http://localhost",
      "expected": "reject",
      "description": "localhost without port"
    },
    {
      "input": "http://localhost:3000",
      "expected": "reject",
      "description": "localhost with port"
    },
    {
      "input": "http://127.0.0.1",
      "expected": "reject",
      "description": "Loopback IP 127.0.0.1"
    },
    {
      "input": "http://[::1]",
      "expected": "reject",
      "description": "IPv6 loopback address"
    },
    {
      "input": "http://10.0.0.1",
      "expected": "reject",
      "description": "Private IP 10.0.0.0/8"
    },
    {
      "input": "http://192.168.1.1",
      "expected": "reject",
      "description": "Private IP 192.168.0.0/16"
    },
    {
      "input": "http://172.16.0.1",
      "expected": "reject",
      "description": "Private IP 172.16.0.0/12"
    },
    {
      "input": "http://169.254.169.254",
      "expected": "reject",
      "description": "Link-local / cloud metadata endpoint"
    },
    {
      "input": "http://user:pass@example.com",
      "expected": "reject",
      "description": "Embedded credentials (userinfo)"
    },
    {
      "input": "http://user@example.com",
      "expected": "reject",
      "description": "Embedded username only"
    },
    {
      "input": "http://host.internal",
      "expected": "reject",
      "description": "Private domain suffix .internal"
    },
    {
      "input": "http://host.private",
      "expected": "reject",
      "description": "Private domain suffix .private"
    },
    {
      "input": "http://host.local",
      "expected": "reject",
      "description": "Private domain suffix .local"
    },
    {
      "input": "http://\u4f8b\u3048.jp/path",
      "expected": "allow",
      "description": "Unicode domain name (Japanese)"
    },
    {
      "input": "http://[::ffff:127.0.0.1]",
      "expected": "reject",
      "description": "IPv4-mapped IPv6 loopback"
    },
    {
      "input": "http://[0:0:0:0:0:ffff:10.0.0.1]",
      "expected": "reject",
      "description": "IPv4-mapped IPv6 private IP"
    },
    {
      "input": "http://example.com:0",
      "expected": "reject",
      "description": "Port 0"
    },
    {
      "input": "http://example.com:65536",
      "expected": "reject",
      "description": "Port out of range (65536)"
    },
    {
      "input": "http://example.com:99999",
      "expected": "reject",
      "description": "Port way out of range (99999)"
    },
    {
      "input": "http://example.com/path\u0000more",
      "expected": "reject",
      "description": "Null byte in URL path"
    },
    {
      "input": "http://example.com\\@evil.com/path",
      "expected": "reject",
      "description": "Backslash in path (backslash abuse)"
    },
    {
      "input": "http://example.com/path\twith\ttabs",
      "expected": "reject",
      "description": "Tab character in URL"
    },
    {
      "input": "http://example.com/path\nwith\nnewlines",
      "expected": "reject",
      "description": "Newline character in URL"
    },
    {
      "input": "http://example.com/path\u0000\u0001\u0002",
      "expected": "reject",
      "description": "Control characters in URL path"
    },
    {
      "input": "http://example.com:8080/valid/path",
      "expected": "allow",
      "description": "Valid URL with port for comparison"
    }
  ]
}