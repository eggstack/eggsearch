{
  "id": "security_applicability_multiple_ranges_unknown_collapses",
  "description": "Multiple advisory ranges where one evaluates to NotAffected and one to Unknown. Unknown must collapse to Unknown (conservative).",
  "tool": "security_search",
  "request": {
    "query": "vulnerability in test-pkg",
    "ecosystem": "crates.io",
    "package": "test-pkg",
    "version": "1.5.0",
    "assess_applicability": true
  },
  "mock_engines": [
    {
      "name": "mock_a",
      "results": [
        {
          "title": "GHSA-test-0005a: Vulnerability in test-pkg (parseable range)",
          "url": "https://osv.dev/vulnerability/GHSA-test-0005a",
          "snippet": "Affected versions: >= 5.0.0"
        },
        {
          "title": "GHSA-test-0005b: Vulnerability in test-pkg (unparseable range)",
          "url": "https://osv.dev/vulnerability/GHSA-test-0005b",
          "snippet": "Affected versions: banana"
        }
      ]
    }
  ],
  "expect": {
    "mode": "security_metasearch",
    "applicability_status": "unknown",
    "notes": "Version 1.5.0 is outside >= 5.0.0 (NotAffected) but 'banana' is unparseable (Unknown). NotAffected + Unknown must collapse to Unknown. Tested directly in tests/security_applicability_regression.rs."
  }
}
