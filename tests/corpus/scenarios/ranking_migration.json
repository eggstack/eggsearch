{
  "id": "ranking_migration",
  "description": "Migration request prioritizes changelog and release notes in suggested fetches",
  "tool": "repo_search",
  "request": {
    "query": "axum migration guide 0.6 to 0.7 changelog",
    "owner": "tokio-rs",
    "repo": "axum",
    "compare_version": "0.6",
    "version": "0.7"
  },
  "mock_engines": [
    {
      "name": "mock_a",
      "results": [
        {
          "title": "axum - GitHub",
          "url": "https://github.com/tokio-rs/axum",
          "snippet": "A web framework for Rust"
        },
        {
          "title": "CHANGELOG.md - axum",
          "url": "https://github.com/tokio-rs/axum/blob/main/CHANGELOG.md",
          "snippet": "Migration notes from 0.6 to 0.7"
        },
        {
          "title": "axum 0.7 release",
          "url": "https://github.com/tokio-rs/axum/releases/tag/v0.7.0",
          "snippet": "Release notes"
        }
      ]
    }
  ],
  "expect": {
    "groups_present": ["changelog", "releases"],
    "suggested_fetches": {
      "min": 1,
      "contains_url_pattern": "CHANGELOG|releases"
    },
    "warnings_contain": [],
    "trust": "external_untrusted"
  }
}
