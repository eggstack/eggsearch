# MINIMIZED TEST FIXTURE MODELED FROM REAL CARGO MANIFESTS.
[package]
name = "demo"
version = "0.1.0"
edition = "2021"

[dependencies]
serde = "1.0.193"
tokio = { version = "1.35", features = ["full"] }
renamed = { package = "real-crate", version = "2.0" }
git-dep = { git = "https://example.com/git-dep", branch = "main" }
local-dep = { path = "../local-dep" }
workspace-dep = { workspace = true }

[dev-dependencies]
criterion = "0.5"

[target.'cfg(windows)'.dependencies]
winapi = "0.3"
